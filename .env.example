# Optional. Scanning needs no .env.local: run `npm run dev` and paste a key.
# Copy to .env.local only for the settings below. Never commit real tokens.

# Only for `npm run demo:snapshot`, which refreshes the sample report: service
# key of the developer test portal whose scan becomes the sample (read-only
# scopes). Scanning doesn't use it; keys are pasted into the page.
HUBSPOT_TOKEN=

# Live scanning is on by default and off on Vercel. Set to true to turn it on
# for your own Vercel deployment, or false to turn it off anywhere.
# ENABLE_LIVE_SCAN=true

# Development only: shows a "Run simulated 250K scan" button that scans a
# fake portal. Ignored by production builds.
# ENABLE_SIMULATOR=true
