# Copy to .env.local for local development. Never commit real tokens.
# Service key from a HubSpot developer test portal (read-only scopes).
# The app does not read this yet; keys are pasted into the UI.
HUBSPOT_TOKEN=

# Development only: shows a "Run simulated 250K scan" button that scans a
# fake portal. Ignored by production builds.
# ENABLE_SIMULATOR=true
