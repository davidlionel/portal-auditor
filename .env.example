# Copy to .env.local for local development. Never commit real tokens.

# Turns on scanning with a pasted service key. Leave unset on a public
# deployment, which then shows the sample report only.
ENABLE_LIVE_SCAN=true

# Only for `npm run demo:snapshot`: service key of the developer test portal
# whose scan becomes the public sample report (read-only scopes). The app
# itself never reads it; keys are pasted into the page.
HUBSPOT_TOKEN=

# Development only: shows a "Run simulated 250K scan" button that scans a
# fake portal. Ignored by production builds.
# ENABLE_SIMULATOR=true
